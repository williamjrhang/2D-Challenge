# LIGHT layout for watching a run ON the robot PC (22 Nov): map, frontiers, Nav2 plan,
# TF, odometry at 3 fps. Costmaps + scan are in the list but OFF: tick them on only
# briefly to check walls (they cost a lot of CPU over Remote Desktop).
Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Map
    Name: Map (SLAM)
    Enabled: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    Alpha: 0.7
    Color Scheme: map
  - Class: rviz_default_plugins/Map
    Name: Global costmap (Nav2 planner)
    Enabled: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
    Alpha: 0.3
    Color Scheme: costmap
  - Class: rviz_default_plugins/Map
    Name: Local costmap (what Nav2 avoids)
    Enabled: false
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
    Alpha: 0.4
    Color Scheme: costmap
  - Class: rviz_default_plugins/LaserScan
    Name: Scan (walls)
    Enabled: false
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
    Size (m): 0.04
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: false
    Marker Scale: 0.4
    Frames:
      All Enabled: false
      base_link:
        Value: true
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Topic:
      Value: /odom
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
    Keep: 20
    Shape:
      Value: Arrow
      Color: 255; 25; 0
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.05
  - Class: rviz_default_plugins/Path
    Name: Nav2 plan
    Enabled: true
    Topic:
      Value: /plan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
    Color: 0; 200; 0
    Line Style: Billboards
    Line Width: 0.03
  - Class: rviz_default_plugins/MarkerArray
    Name: Frontiers
    Enabled: true
    Topic:
      Value: /exploration/frontiers
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
  Global Options:
    Fixed Frame: map
    Frame Rate: 3
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
    Saved: null
